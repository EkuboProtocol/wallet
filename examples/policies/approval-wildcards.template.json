{
  "$schema": "https://raw.githubusercontent.com/EkuboProtocol/wallet/main/schemas/policy.schema.json",
  "version": 1,
  "rules": [
    {
      "effect": "allow",
      "label": "TEMPLATE: transfers to named recipients on any network",
      "calldata": {
        "selector": {
          "abi": "transfer(address to, uint256 amount)",
          "args": { "to": { "in": ["0x2222222222222222222222222222222222222222"] } }
        }
      }
    },
    {
      "effect": "deny",
      "label": "TEMPLATE: all other Base transactions are disabled",
      "chain_id": { "eq": "8453" }
    }
  ]
}
