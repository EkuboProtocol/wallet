{
  "$schema": "https://raw.githubusercontent.com/EkuboProtocol/wallet/main/schemas/policy.schema.json",
  "version": 1,
  "rules": [
    {
      "effect": "allow",
      "label": "Revoke an ERC-20 allowance",
      "calldata": {
        "selector": {
          "abi": "approve(address spender, uint256 amount)",
          "args": { "amount": { "eq": "0" } }
        }
      }
    },
    {
      "effect": "allow",
      "label": "Revoke an NFT operator",
      "calldata": {
        "selector": {
          "abi": "setApprovalForAll(address operator, bool approved)",
          "args": { "approved": { "eq": "false" } }
        }
      }
    }
  ]
}
