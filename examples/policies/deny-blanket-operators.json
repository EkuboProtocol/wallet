{
  "$schema": "https://raw.githubusercontent.com/EkuboProtocol/wallet/main/schemas/policy.schema.json",
  "version": 1,
  "rules": [
    {
      "effect": "deny",
      "label": "Never grant a blanket NFT operator",
      "calldata": {
        "selector": {
          "abi": "setApprovalForAll(address operator, bool approved)",
          "args": { "approved": { "eq": "true" } }
        }
      }
    },
    {
      "effect": "deny",
      "label": "Never grow an allowance through a relative-increase function",
      "calldata": {
        "any": [
          { "selector": { "abi": "increaseAllowance(address spender, uint256 addedValue)" } },
          { "selector": { "abi": "increaseApproval(address spender, uint256 addedValue)" } }
        ]
      }
    },
    {
      "effect": "allow",
      "label": "Allow every other transaction call"
    }
  ]
}
