{
  "$schema": "https://raw.githubusercontent.com/EkuboProtocol/wallet/main/schemas/policy.schema.json",
  "version": 1,
  "rules": [
    {
      "effect": "allow",
      "label": "Ethereum multicall containing only transfers to a named recipient",
      "chain_id": { "eq": "1" },
      "to": { "eq": "0x1111111111111111111111111111111111111111" },
      "native_value": { "eq": "0" },
      "calldata": {
        "selector": {
          "abi": "multicall(bytes[] data)",
          "args": {
            "data": {
              "each": {
                "selector": {
                  "abi": "transfer(address to, uint256 amount)",
                  "args": { "to": { "eq": "0x2222222222222222222222222222222222222222" } }
                }
              }
            }
          }
        }
      }
    }
  ]
}
