{
  "$schema": "https://raw.githubusercontent.com/EkuboProtocol/wallet/main/schemas/policy.schema.json",
  "version": 1,
  "rules": [
    {
      "effect": "deny",
      "label": "not: reject targets outside a known set on Ethereum",
      "chain_id": { "eq": "1" },
      "to": {
        "not": {
          "in": [
            "0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48",
            "0x1111111111111111111111111111111111111111"
          ]
        }
      }
    },
    {
      "effect": "allow",
      "label": "all and numeric comparisons: bounded transfer to this wallet or a named recipient",
      "chain_id": { "eq": "1" },
      "to": { "eq": "0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48" },
      "calldata": {
        "selector": {
          "abi": "transfer(address to, uint256 amount)",
          "args": {
            "to": {
              "all": [
                { "in": ["$self", "0x2222222222222222222222222222222222222222"] },
                { "not": { "eq": "0x0000000000000000000000000000000000000000" } }
              ]
            },
            "amount": { "lte": "1000000" }
          }
        }
      }
    },
    {
      "effect": "allow",
      "label": "any and length: one or two nested calls, or poke",
      "chain_id": { "eq": "1" },
      "to": { "eq": "0x1111111111111111111111111111111111111111" },
      "native_value": { "in": ["0", "1000000000000000000"] },
      "calldata": {
        "any": [
          { "selector": { "abi": "multicall(bytes[] data)", "args": { "data": { "length": { "in": ["1", "2"] } } } } },
          { "selector": { "abi": "poke()" } }
        ]
      }
    }
  ]
}
