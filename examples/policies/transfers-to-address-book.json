{
  "$schema": "https://raw.githubusercontent.com/EkuboProtocol/wallet-mcp-server/main/schemas/policy.schema.json",
  "version": 1,
  "chains": {
    "1": {
      "label": "Move confirmed tokens, but only to addresses the owner has named",
      "max_calls_per_batch": 4,
      "native_value": { "eq": "0" },
      "rules": [
        {
          "effect": "allow",
          "label": "ERC-20 transfer to any address-book entry, in any amount",
          "to": "is_token",
          "calldata": {
            "selector": {
              "abi": "transfer(address to, uint256 amount)",
              "args": { "to": "is_address_book" }
            }
          }
        }
      ]
    }
  }
}
