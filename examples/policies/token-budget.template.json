{
  "$schema": "https://raw.githubusercontent.com/EkuboProtocol/wallet-mcp-server/main/schemas/policy.schema.json",
  "version": 1,
  "chains": {
    "1": {
      "label": "TEMPLATE: replace every address and signature before use",
      "max_calls_per_batch": 8,
      "native_value": { "eq": "0" },
      "rules": [
        {
          "effect": "deny",
          "label": "Never hand an operator a whole NFT collection",
          "calldata": {
            "selector": {
              "abi": "setApprovalForAll(address operator, bool approved)",
              "args": { "approved": { "eq": "true" } }
            }
          }
        },
        {
          "effect": "allow",
          "label": "TEMPLATE: approve only this router to spend only this token",
          "to": { "eq": "0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48" },
          "calldata": {
            "selector": {
              "abi": "approve(address spender, uint256 amount)",
              "args": {
                "spender": { "eq": "0x1111111111111111111111111111111111111111" }
              }
            }
          }
        },
        {
          "effect": "allow",
          "label": "TEMPLATE: swap on that router, with the proceeds paid to this wallet",
          "to": { "eq": "0x1111111111111111111111111111111111111111" },
          "calldata": {
            "selector": {
              "abi": "swapExactTokensForTokens(uint256 amountIn, uint256 amountOutMin, address[] path, address to, uint256 deadline)",
              "args": {
                "path": { "each": { "in": ["0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48", "0xc02aaa39b223fe8d0a0e5c4f27ead9083c756cc2"] } },
                "to": "is_wallet"
              }
            }
          }
        }
      ]
    }
  }
}
