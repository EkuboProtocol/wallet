#compdef ekubo-wallet ew

_ekubo-wallet() {
  local -a choices

  if (( CURRENT == 2 )); then
    _values "command" server version status account acct wallet network net policy transaction tx token address-book legal review completion \
      --data-dir --json --help --version
    return
  fi

  if (( CURRENT == 3 )); then
    case "$words[2]" in
      account|acct|wallet) _values "account command" list create import export remove ;;
      network|net) _values "network command" list presets reset add edit remove delete review ;;
      policy) _values "policy command" show set allow-all require-approval validate schema review ;;
      transaction|tx) _values "transaction command" list show cancel rebroadcast discard ;;
      token) _values "token command" list search review import ;;
      address-book) _values "address book command" list add remove delete ;;
      legal) _values "legal command" status show accept ;;
      review)
        choices=("${(@f)$(ekubo-wallet __complete approvals-described 2>/dev/null)}")
        _describe "pending approval" choices
        ;;
      completion) _values "shell" bash zsh fish elvish powershell ;;
    esac
    return
  fi

  if (( CURRENT == 4 )); then
    case "$words[2]:$words[3]" in
      policy:validate) _files -g '*.json' ;;
      account:export|account:remove|acct:export|acct:remove|wallet:export|wallet:remove|policy:show|policy:set|policy:allow-all|policy:require-approval|policy:review|transaction:list|tx:list)
        choices=("${(@f)$(ekubo-wallet __complete wallets-described 2>/dev/null)}")
        _describe "account" choices
        ;;
      network:add)
        choices=("${(@f)$(ekubo-wallet __complete defaults-described 2>/dev/null)}")
        _describe "default network" choices
        ;;
      network:edit|network:remove|network:delete)
        choices=("${(@f)$(ekubo-wallet __complete networks-described 2>/dev/null)}")
        _describe "network" choices
        ;;
      address-book:list|address-book:add|address-book:remove|address-book:delete)
        choices=("${(@f)$(ekubo-wallet __complete networks-described 2>/dev/null)}")
        _describe "network" choices
        ;;
      legal:show) _values "legal document" terms privacy licenses ;;
    esac
    return
  fi

  if (( CURRENT == 5 )); then
    case "$words[2]:$words[3]" in
      policy:set) _files -g '*.json' ;;
      network:add)
        _values "network option" --rpc-url --display-name --alias --native-currency-name \
          --native-currency-symbol --native-currency-decimals --max-gas-limit \
          --block-explorer-url --documentation-url
        ;;
    esac
  fi

  if (( CURRENT > 5 )) && [[ "$words[2]:$words[3]" == "network:add" ]]; then
    _values "network option" --rpc-url --display-name --alias --native-currency-name \
      --native-currency-symbol --native-currency-decimals --max-gas-limit \
      --block-explorer-url --documentation-url
  fi
}

_ekubo-wallet "$@"
