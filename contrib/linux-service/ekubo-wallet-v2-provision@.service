[Unit]
Description=Ekubo Wallet 2 fresh provisioning for owner UID %i
Requires=dbus.socket
After=dbus.socket
ConditionPathExists=/etc/ekubo-wallet-v2/pending/%i.json

[Service]
Type=dbus
BusName=org.ekubo.Wallet2.Provision.u%i
User=ekubo-wallet-v2
Group=ekubo-wallet-v2
ExecStart=/usr/lib/ekubo-wallet-v2/ekubo-wallet-service --provision-owner-uid %i
WorkingDirectory=/
UMask=0077
Restart=no
TimeoutStopSec=30s
KillMode=control-group
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/ekubo-wallet-v2/pending
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
LimitCORE=0
