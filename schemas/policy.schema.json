{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ekubo Wallet policy",
  "type": "object",
  "properties": {
    "$schema": {
      "type": [
        "string",
        "null"
      ]
    },
    "version": {
      "type": "integer",
      "format": "uint8",
      "minimum": 0,
      "maximum": 255,
      "default": 1
    },
    "chains": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ChainPolicy"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "chains"
  ],
  "$defs": {
    "ChainPolicy": {
      "type": "object",
      "properties": {
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "max_calls_per_batch": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 16
        },
        "native_value": {
          "description": "Applied to every call independently, on top of whichever rule matched.\nA guard rather than a grant: no rule can widen it. Omitted, it is\n`{\"eq\": \"0\"}`, so a document that never mentions native value never\nsends any.",
          "$ref": "#/$defs/Predicate",
          "default": {
            "eq": "0"
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Rule"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "Predicate": {
      "description": "One predicate over one value.\n\nExternally tagged, so a document reads `{\"in\": [\"0x…\"]}`, `\"is_wallet\"`, or\n`{\"each\": {\"selector\": {\"abi\": \"…\"}}}`.",
      "oneOf": [
        {
          "description": "Matches every value, including one this policy cannot decode. The only\nway to write an unconstrained slot explicitly.",
          "type": "string",
          "const": "any_value"
        },
        {
          "type": "object",
          "properties": {
            "eq": {
              "type": "string"
            }
          },
          "required": [
            "eq"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "in": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "in"
          ],
          "additionalProperties": false
        },
        {
          "description": "The address is this wallet. The predicate that makes a rule portable:\n\"proceeds must come back to me\" without naming an address.",
          "type": "string",
          "const": "is_wallet"
        },
        {
          "type": "object",
          "properties": {
            "selector": {
              "$ref": "#/$defs/SelectorPredicate"
            }
          },
          "required": [
            "selector"
          ],
          "additionalProperties": false
        },
        {
          "description": "Every element of an array satisfies the inner predicate. An empty array\nsatisfies it vacuously.",
          "type": "object",
          "properties": {
            "each": {
              "$ref": "#/$defs/Predicate"
            }
          },
          "required": [
            "each"
          ],
          "additionalProperties": false
        },
        {
          "description": "At least one of these predicates matches. An empty list never matches.",
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Predicate"
              }
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false
        },
        {
          "description": "All of these predicates match. An empty list matches vacuously.",
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Predicate"
              }
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/$defs/Predicate"
            }
          },
          "required": [
            "not"
          ],
          "additionalProperties": false
        },
        {
          "description": "The element count of an array, or the byte length of a `bytes` or\n`string`, satisfies the inner predicate as a `uint256`.",
          "type": "object",
          "properties": {
            "length": {
              "$ref": "#/$defs/Predicate"
            }
          },
          "required": [
            "length"
          ],
          "additionalProperties": false
        }
      ]
    },
    "SelectorPredicate": {
      "type": "object",
      "properties": {
        "abi": {
          "type": "string"
        },
        "args": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Predicate"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "abi"
      ]
    },
    "Rule": {
      "description": "One rule: a conjunction of predicate slots and the effect of matching them.",
      "type": "object",
      "properties": {
        "effect": {
          "$ref": "#/$defs/Effect"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "to": {
          "description": "The contract or recipient being called.",
          "anyOf": [
            {
              "$ref": "#/$defs/Predicate"
            },
            {
              "type": "null"
            }
          ]
        },
        "from": {
          "description": "The sending wallet. Rarely needed — a plan's sender is already bound to\nthe selected wallet before a policy ever sees it — but available so one\ndocument can carry rules for several wallets.",
          "anyOf": [
            {
              "$ref": "#/$defs/Predicate"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "description": "Native value attached to this call, in wei.",
          "anyOf": [
            {
              "$ref": "#/$defs/Predicate"
            },
            {
              "type": "null"
            }
          ]
        },
        "calldata": {
          "description": "The call's calldata. `{\"eq\": \"0x\"}` is a plain native send; a\n`selector` predicate decodes it and constrains its arguments.",
          "anyOf": [
            {
              "$ref": "#/$defs/Predicate"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "effect"
      ]
    },
    "Effect": {
      "type": "string",
      "enum": [
        "allow",
        "deny"
      ]
    }
  },
  "description": "Stateless per-call signing policy. Each chain holds an unordered set of rules: any matching deny rule denies, otherwise any matching allow rule allows, otherwise the call is denied. There are no amount limits, budgets, or spend counters — a rule bounds which calls may be made, not how much they move."
}
